# 本番用（backend/.env として配置する）。開発用の .env.example とは別物。
# APP_KEY は必ずサーバ上で生成すること: php artisan key:generate

APP_NAME=kakeibo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kakeibo.drasewkit.dev

APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

# 同一オリジン構成のため、フロントもAPIもこのホスト
SANCTUM_STATEFUL_DOMAINS=kakeibo.drasewkit.dev
FRONTEND_URL=https://kakeibo.drasewkit.dev

LOG_CHANNEL=stack
LOG_LEVEL=warning

# docker-compose.prod.yml のサービス名で解決する
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kakeibo
DB_USERNAME=kakeibo
DB_PASSWORD=ここに強いパスワード（ルート直下の .env と同じ値）

SESSION_DRIVER=database
# PWAとしてホーム画面から使う想定のため長めに取る（30日）
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
# 先頭ドットを付けない。付けるとポートフォリオ側のサブドメインにもクッキーが飛ぶ
SESSION_DOMAIN=kakeibo.drasewkit.dev
SESSION_SAME_SITE=lax
# Cloudflare Tunnelで常にHTTPSになるため有効にする
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
