# docker-compose.prod.yml が読む変数（リポジトリ直下に .env として置く）
# 本番サーバ上でのみ作成し、コミットしない

# MySQLの認証情報。backend/.env の DB_* と必ず同じ値にする
DB_DATABASE=kakeibo
DB_USERNAME=kakeibo
DB_PASSWORD=ここに強いパスワード
DB_ROOT_PASSWORD=ここに別の強いパスワード

# 新規登録の受付可否（フロントのビルド時に埋め込まれる）。公開するまでは書かない（未指定は無効）。
# backend/.env の REGISTRATION_ENABLED と揃え、変更したら frontend を再ビルドする
# NEXT_PUBLIC_REGISTRATION_ENABLED=true

# Cloudflare Tunnel のトークン（Cloudflareダッシュボードで発行）
TUNNEL_TOKEN=ここにトークン
